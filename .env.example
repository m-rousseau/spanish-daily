# Your Anthropic API key (https://console.anthropic.com/settings/keys). Server-side only.
ANTHROPIC_API_KEY=sk-ant-...

# Who can log in: comma-separated name:password pairs.
APP_USERS=Maman:choose-a-password

# Random string of at least 32 characters, used to sign login cookies.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Family photo gallery (optional). A private Google Drive folder shared (Viewer) with a service account.
# GOOGLE_SERVICE_ACCOUNT_EMAIL: "client_email" from the service account's JSON key
# GOOGLE_SERVICE_ACCOUNT_KEY: "private_key" from the same JSON (keep the \n as written)
# GOOGLE_DRIVE_FOLDER_ID: the folder's ID or its full URL
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Optional: iCloud Shared Album set to "Anyone with the Link" (photos added from an iPhone appear in the gallery)
ICLOUD_ALBUM_URL=
